@startuml
!include <archimate/Archimate>
left to right direction
skinparam linetype ortho
skinparam nodesep 90
skinparam ranksep 90
skinparam padding 20
skinparam shadowing false
skinparam defaultFontName Arial
title isac-chat-mobile – integrácie, nasadenie a hranice (ArchiMate, 2026-09-24)
legend right
  ArchiMate elements follow the repository reference archnodes.puml.
  Orthogonal lines and explicit layer/group separation prevent routes through elements.
  Source evidence is not runtime or customer acceptance evidence.
  Java 25 / Spring Boot 4.1.1 is the verified main baseline; exceptions remain explicit.
endlegend
Grouping(EXTERNAL, "External / partner layer") {
  Business_Actor(PARTNER, "Partner / external system")
  Application_Service(CONTRACT, "Approved API / event contract")
  Rel_Serving(CONTRACT, PARTNER, "provides input")
}
Grouping(APPLICATION, "Application layer") {
  Application_Component(MODULE, "Kotlin / Gradle Android client")
  Application_Service(INBOUND, "Inbound adapter / endpoint")
  Application_Service(OUTBOUND, "Outbound contract / projection")
  Rel_Serving(MODULE, INBOUND, "accepts")
  Rel_Serving(MODULE, OUTBOUND, "publishes")
  Rel_Flow(CONTRACT, INBOUND, "validated contract")
}
Grouping(PLATFORM, "Technology and deployment layer") {
  Technology_SystemSoftware(JAVA, "Java 25")
  Technology_SystemSoftware(SPRING, "Spring Boot 4.1.1")
  Technology_SystemSoftware(IAM, "Keycloak / tenant policy")
  Technology_SystemSoftware(BROKER, "RabbitMQ / MQTT / HTTP")
  Technology_Node(RUNTIME, "Compose / Kubernetes / customer overlay")
  Technology_SystemSoftware(DB, "Module-owned database / schema")
  Rel_Assignment(JAVA, SPRING, "platform")
  Rel_Assignment(RUNTIME, MODULE, "deploys")
  Rel_Assignment(SPRING, MODULE, "runs")
  Rel_Serving(IAM, MODULE, "authorizes")
  Rel_Serving(BROKER, OUTBOUND, "transports")
  Rel_Access(MODULE, DB, "persists")
}
Grouping(CONSUMERS, "Downstream consumers") {
  Application_Component(C0, "isac-chat")
  Application_Component(C1, "isac-api-spec")
}
Rel_Flow(OUTBOUND, C0, "typed delivery")
Rel_Flow(OUTBOUND, C1, "typed delivery")
@enduml
